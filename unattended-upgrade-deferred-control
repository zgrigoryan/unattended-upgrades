# systemd starts this service as root when a client connects to its socket
# (unattended-upgrades-control.socket) and it exits again when idle. It
# implements com.ubuntu.UnattendedUpgrade.Deferred:
#
#   Skip()    move the apply-on-shutdown marker aside, so the shutdown
#             helper does not install the deferred updates this shutdown
#   Enable()  put a skipped marker back
#
# Every call is authorized with polkit for the calling process. Neither
# method touches ordinary unattended-upgrades runs; a later regular run
# recreates the marker if deferred work is still pending, and /run is
# cleared at reboot.

from __future__ import annotations

import gettext
import logging
import os
import socket
import struct
import sys
import threading
from collections.abc import Callable
from gettext import gettext as _
from typing import Any

import varlink

APPLY_ON_SHUTDOWN_FILE = "/var/run/unattended-upgrades-apply-on-shutdown"
# Where a skipped marker is kept so that Enable() can restore exactly it.
SKIPPED_FILE = APPLY_ON_SHUTDOWN_FILE + ".skipped"

INTERFACE = "com.ubuntu.UnattendedUpgrade.Deferred"
INTERFACE_DIR = "/usr/share/unattended-upgrades"
SOCKET_PATH = "/run/unattended-upgrades/" + INTERFACE
# polkit actions, see com.ubuntu.unattended-upgrade.policy
ACTIONS = {
    "Skip": INTERFACE + ".Skip",
    "Enable": INTERFACE + ".Enable",
}
# exit after this many seconds without a connection
IDLE_TIMEOUT = 30

# not exposed by the socket module before Python 3.15
SO_PEERPIDFD = getattr(socket, "SO_PEERPIDFD", 77)

Authorize = Callable[[str, socket.socket], None]


class NotAuthorized(varlink.VarlinkError):
    def __init__(self, reason: str) -> None:
        super().__init__({"error": INTERFACE + ".NotAuthorized",
                          "parameters": {"reason": reason}})


class Failed(varlink.VarlinkError):
    def __init__(self, reason: str) -> None:
        super().__init__({"error": INTERFACE + ".Failed",
                          "parameters": {"reason": reason}})


def _path(rootdir: str, filename: str) -> str:
    return os.path.join(rootdir, filename.lstrip("/"))


def skip(rootdir: str = "/") -> None:
    """Skip installing deferred updates at the next shutdown."""
    try:
        os.replace(_path(rootdir, APPLY_ON_SHUTDOWN_FILE),
                   _path(rootdir, SKIPPED_FILE))
    except FileNotFoundError:
        # Nothing is pending, so there is nothing to skip.
        pass


def enable(rootdir: str = "/") -> None:
    """Re-enable installing deferred updates that were skipped."""
    try:
        os.replace(_path(rootdir, SKIPPED_FILE),
                   _path(rootdir, APPLY_ON_SHUTDOWN_FILE))
    except FileNotFoundError:
        # Nothing was skipped; do not invent pending work.
        pass


def caller_subject(sock: socket.socket) -> tuple[Any, int | None]:
    """The polkit subject of the peer of sock, and a pidfd to close.

    A pidfd identifies the caller without the pid reuse race; without one
    (older kernels or polkit), fall back to the pid and the caller's uid.
    """
    import gi
    gi.require_version("Polkit", "1.0")
    from gi.repository import Polkit
    pid, uid, _gid = struct.unpack(
        "3i", sock.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED,
                              struct.calcsize("3i")))
    try:
        pidfd = sock.getsockopt(socket.SOL_SOCKET, SO_PEERPIDFD)
    except OSError:
        pidfd = None
    if pidfd is not None and hasattr(Polkit.UnixProcess, "new_pidfd"):
        return Polkit.UnixProcess.new_pidfd(pidfd, uid, None), pidfd
    if pidfd is not None:
        os.close(pidfd)
    return Polkit.UnixProcess.new_for_owner(pid, 0, uid), None


def polkit_authorize(action_id: str, sock: socket.socket) -> None:
    """Raise NotAuthorized unless polkit allows the peer of sock action_id.

    The caller's polkit agent may prompt for authentication. Any failure
    to ask polkit denies the call.
    """
    pidfd = None
    try:
        subject, pidfd = caller_subject(sock)
        from gi.repository import Polkit
        result = Polkit.Authority.get_sync(None).check_authorization_sync(
            subject, action_id, None,
            Polkit.CheckAuthorizationFlags.ALLOW_USER_INTERACTION, None)
        authorized = result.get_is_authorized()
    except Exception as error:
        logging.warning("Could not check %s with polkit: %s",
                        action_id, error)
        raise NotAuthorized(_("Failed to interrogate Polkit"))
    finally:
        if pidfd is not None:
            os.close(pidfd)
    if not authorized:
        raise NotAuthorized(_("Polkit returned not authorized"))


def make_service(interface_dir: str = INTERFACE_DIR,
                 rootdir: str = "/",
                 authorize: Authorize = polkit_authorize,
                 ) -> varlink.Service:
    service = varlink.Service(
        vendor="Debian",
        product="unattended-upgrades",
        version="1",
        url="https://github.com/mvo5/unattended-upgrades",
        interface_dir=interface_dir)

    def run(method: str, action: Callable[[str], None],
            request: socket.socket) -> dict[str, Any]:
        authorize(ACTIONS[method], request)
        try:
            action(rootdir)
        except OSError as error:
            raise Failed(str(error))
        logging.info("%s() by the deferred installation control", method)
        return {}

    @service.interface(INTERFACE)
    class Deferred:
        def Skip(self, _request: socket.socket) -> dict[str, Any]:
            return run("Skip", skip, _request)

        def Enable(self, _request: socket.socket) -> dict[str, Any]:
            return run("Enable", enable, _request)

    return service


def serve(service: varlink.Service, address: str,
          idle_timeout: float = IDLE_TIMEOUT) -> None:
    """Serve requests until idle_timeout passes without any connection."""
    active = 0
    lock = threading.Lock()

    class Handler(varlink.RequestHandler):
        def handle(self) -> None:
            nonlocal active
            with lock:
                active += 1
            try:
                super().handle()
            finally:
                with lock:
                    active -= 1

    Handler.service = service

    class Server(varlink.ThreadingServer):
        daemon_threads = True
        timeout = idle_timeout
        timed_out = False

        def handle_timeout(self) -> None:
            self.timed_out = True

    # with socket activation the server uses the socket systemd passes in
    with Server(address, Handler) as server:
        while True:
            server.timed_out = False
            server.handle_request()
            with lock:
                if server.timed_out and not active:
                    return


def main(argv: list[str]) -> int:
    logging.basicConfig(level=logging.INFO,
                        format="%(levelname)s - %(message)s")
    if os.geteuid() != 0:
        sys.stderr.write(_("This service must be run as root.\n"))
        return 1
    address = argv[1] if len(argv) > 1 else "unix:" + SOCKET_PATH
    serve(make_service(), address)
    return 0


if __name__ == "__main__":
    gettext.bindtextdomain("unattended-upgrades", "/usr/share/locale")
    gettext.textdomain("unattended-upgrades")
    sys.exit(main(sys.argv))
